# Reconcilr (Trade Ledger) Environment Configuration Example
# Copy this file to .env for local deployment

# App Environment & Port
NODE_ENV=production
PORT=8081

# Optional AI Fallback for Low-Confidence (<80%) Statement Lines
# If empty, low-confidence line items are flagged for manual user review in the UI
OPTIONAL_LLM_API_KEY=

# Security & CORS Setup
ALLOWED_ORIGINS=http://localhost:8081,https://reconcilr.tools
MAX_FILE_SIZE_MB=25
